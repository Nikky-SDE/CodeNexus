# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/codenexus?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=replace_with_a_long_random_secret_string
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Code Execution (Judge0)
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=your_judge0_api_key

# Email / SMTP (Optional - falls back to Ethereal test mail in dev if omitted)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="CodeNexus" <no-reply@example.com>

# Frontend (Vite)
VITE_API_URL=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
